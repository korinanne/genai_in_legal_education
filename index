function buildReportLines(){const lines=[]; lines.push('Learning Law with GenAI - Completion and Quiz Grade Report'); lines.push('Generated: '+new Date().toLocaleString()); lines.push(''); lines.push('Student name: '+(state.studentName||'[not entered]')); lines.push('Course / section: '+(state.courseName||'[not entered]')); lines.push('Student ID / Canvas name: '+(state.studentId||'[not entered]')); lines.push('Started: '+formatDate(state.startedAt)); lines.push('Completed: '+(state.completedAt?formatDate(state.completedAt):'[final quiz not submitted]')); lines.push(''); lines.push('Completion'); lines.push('- Required interactions completed: '+requiredActivities.filter(k=>state.activities[k]).length+' / '+requiredActivities.length+' ('+completionPercent()+'%)'); lines.push('- Modules marked complete: '+Object.values(state.slideComplete).filter(Boolean).length+' / '+(lessonSlides.length-1)); lines.push('- Initial certification: '+(state.certStart?'Yes':'No')); lines.push(''); lines.push('Checkpoint Quiz Scores'); Object.keys(checkpoints).forEach(id=>{const s=state.checkpointScores[id]; lines.push('- '+id+': '+(s?(s.score+' / '+s.max+' ('+Math.round(s.score/s.max*100)+'%)'):'not submitted'));}); lines.push(''); lines.push('Final Quiz Grade'); if(state.finalQuizSubmitted){const pct=Math.round(state.finalQuizScore/state.finalQuizMax*100); lines.push('- Score: '+state.finalQuizScore+' / '+state.finalQuizMax+' ('+pct+'%)');} else lines.push('- Final quiz not submitted.'); lines.push(''); lines.push('Final Quiz Item Results'); if(state.finalQuizSubmitted){state.finalQuizDetails.forEach(d=>{lines.push('Q'+d.number+': '+(d.correct?'Correct':'Incorrect')); lines.push('  Student answer: '+(d.selected&&d.selected.length?d.selected.join('; '):'[none]')); lines.push('  Correct answer: '+d.correctAnswer.join('; '));});} else lines.push('[No final quiz item results yet.]'); lines.push(''); lines.push('Student Reflections'); lines.push('Explain-it-back: '+(state.reflections.explain