function renderFinalQuiz(){const form=document.getElementById('finalQuizForm'); if(!form)return; let html=''; finalQuiz.forEach((q,idx)=>{html+='<fieldset class="quiz-question"><legend>Question '+(idx+1)+'. '+esc(q.p)+'</legend><div class="choice-list">'; q.o.forEach(opt=>{const type=q.type==='multi'?'checkbox':'radio'; html+='<label><input type="'+type+'" name="'+q.id+'" value="'+esc(opt)+'"> '+esc(opt)+'</label>';}); html+='</div></fieldset>';}); html+='<div class="choice-list"><label><input type="checkbox" id="certFinal" required> I certify that I completed this lesson and final quiz myself.</label></div><div class="btnrow"><button class="primary" type="submit">Submit final quiz</button><button class="ghost" type="button" onclick="clearFinalQuiz()">Clear final quiz answers</button></div>'; form.innerHTML=html;}
