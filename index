function downloadBlob(content,filename,type){const blob=content instanceof Uint8Array?new Blob([content],{type}):new Blob([content],{type}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=filename; document.body.appendChild(a); a.click(); setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},0);}
