function renderCheckpoint(id){const cfg=checkpoints[id], div=document.getElementById(id); if(!div)return; let html='<form onsubmit="submitCheckpoint(event,\''+id+'\')">'; cfg.questions.forEach((q,idx)=>{html+='<fieldset class="quiz-question"><legend>'+(idx+1)+'. '+esc(q.p)+'</legend><div class="choice-list">'; q.o.forEach((opt,j)=>{const type=q.type==='multi'?'checkbox':'radio'; const name=id+'_'+idx; const checked=(state.checkpointDetails[id]?.answers?.[idx]||[]).includes(opt)?'checked':''; html+='<label><input type="'+type+'" name="'+name+'" value="'+esc(opt)+'" '+checked+'> '+esc(opt)+'</label>';}); html+='</div></fieldset>';}); html+='<div class="btnrow"><button class="secondary" type="submit">Submit checkpoint</button></div></form><div id="'+id+'Feedback" class="feedback"></div>'; div.innerHTML=html; if(state.checkpointScores[id]){setFeedback(id+'Feedback','Current checkpoint score: '+state.checkpointScores[id].score+'/'+state.checkpointScores[id].max+'. You may revise and resubmit.','good');}}
function arraysEqual(a,b){return a.length===b.length && a.every((v,i)=>v===b[i]);}
function submitCheckpoint(e,id){e.preventDefault(); const cfg=checkpoints[id]; let score=0, answers=[], details=[], missing=[]; cfg.questions.forEach((q,idx)=>{const selected=[...document.querySelectorAll('[name="'+id+'_'+idx+'"]:checked')].map(x=>x.value); answers[idx]=selected; if(!selected.length)missing.push(idx+1); const correct=arraysEqual(selected.slice().sort(),q.a.slice().sort()); if(correct)score++; details.push({prompt:q.p,selected,correctAnswer:q.a,correct,explain:q.e});}); if(missing.length){setFeedback(id+'Feedback','Please answer every checkpoint question. Missing: '+missing.join(', '),'warn');return;} state.checkpointScores[id]={score,max:cfg.questions.length}; state.checkpointDetails[id]={answers,details}; markActivity(cfg.activity,true); const pct=Math.round(score/cfg.questions.length*100); setFeedback(id+'Feedback','Checkpoint submitted: '+score+'/'+cfg.questions.length+' ('+pct+'%).<br>'+details.map((d,i)=>'<details><summary>Question '+(i+1)+': '+(d.correct?'Correct':'Incorrect')+'</summary><p><strong>Correct answer:</strong> '+d.correctAnswer.join('; ')+'</p><p>'+esc(d.explain)+'</p></details>').join(''),score===cfg.questions.length?'good':'warn'); saveState(); updateReportPreview();}

